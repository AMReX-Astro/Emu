# Perturbaciones a las condiciones iniciales
perturbation_type = 0
perturbation_amplitude = 0.0

# Par ámetro de atenuación de los hamiltonianos
# Si este parámetro es cero no habrá transformaciones de neutrinos
attenuation_hamiltonians = 1.0

# Controles de paso de tiempo
collision_cfl_factor = 0.25
cfl_factor = 0.25
flavor_cfl_factor = 0.25
max_adaptive_speedup = 0
maxError = 1e-6

# Tipos de integración numérica
# 0 → Euler hacia adelante
# 1 → Runge–Kutta
integration.type = 1
integration.rk.type = 4

# El dominio es el espacio físico de la simulación
ncell = (1, 1, 1)   # número de celdas
Lx = 1e4            # longitud en x del dominio de simulación (cm)
Ly = 1e4            # longitud en y del dominio de simulación (cm)
Lz = 1e4            # longitud en z del dominio de simulación (cm)

# Número de puntos de emisión por celda
nppc = (1, 1, 1)

# Condiciones iniciales de las partículas
particle_data_filename = "particle_input.dat"

# Tamaño máximo de la caja para paralelización
max_grid_size_x = 1
max_grid_size_y = 1
max_grid_size_z = 1

# Número de pasos de tiempo
nsteps = 80000

# Paso de tiempo mínimo (s)
minimum_time_step = 1e-15

# Método para calcular el paso de tiempo óptimo
time_step_method = 1

# Forzar tiempo final de la simulación (s)
end_time = 5.0e19

# Activa señales FPE para obtener un backtrace
amrex.fpe_trap_invalid = 1

# Condiciones de fluido de fondo
rho_g_ccm = 0
T_MeV = 7.0
Ye = 0

# Escritura de archivos de salida de datos en la malla (plotfiles)
write_plot_every = 400

# Escritura de datos de partículas
write_plot_particles_every = 400

# Puntos de control (checkpointing)
do_restart = 0
restart_dir = ""

set_equilibrium_distribution = 0

