# GNUmakefile for OLCF Frontier (AMD MI250X GPUs, gfx90a).
#
# compute modules
#module purge
#module load cpe/26.03
#module load rocm/7.0.2
#module load PrgEnv-cray
#module load craype-x86-trento
#module load craype-accel-amd-gfx90a
#module load cray-hdf5-parallel
#module load darshan-runtime
#module load python/3.10-miniforge3
#module load xpmem
#module load cray-pmi
#export LD_LIBRARY_PATH=${CRAY_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH}
#export MPICH_GPU_SUPPORT_ENABLED=1

# head modules
#module load Core/26.05
#module load emacs/30.2
#
# At runtime (not build time), enable GPU-aware MPI:
#   export MPICH_GPU_SUPPORT_ENABLED=1
#
# AMReX auto-detects Frontier from $LMOD_SITE_NAME=OLCF and `hostname -f`, and sets
# AMD_ARCH=gfx90a plus the GPU-aware MPI link flags (-lmpi_gtl_hsa) itself — see
# submodules/amrex/Tools/GNUMake/sites/Make.olcf. No AMD_ARCH setting is needed here.
#
# `make generate` also needs sympy, which isn't preinstalled. Install it with
# `pip install --user sympy` while python/3.10-miniforge3 (above) is loaded — do NOT
# just run bare `pip3 install --user sympy`: on this system /usr/bin/python3 is
# Python 3.6 but /usr/bin/pip3 is shebanged to Python 3.11, so a bare pip3 install
# silently lands in the 3.11 user site-packages, which the bare `python3` that
# `make generate` invokes (3.6, or 3.10 once this module is loaded) never sees.

NUM_FLAVORS = 2
SHAPE_FACTOR_ORDER = 2
NUM_MOMENTS = 3

COMP = hip

DEBUG = FALSE

USE_MPI  = TRUE
USE_OMP  = FALSE
USE_ACC  = FALSE
USE_HIP  = TRUE
USE_CUDA = FALSE

USE_HDF5  = TRUE
HDF5_HOME = $(HDF5_DIR)

EMU_HOME = ..
AMREX_HOME = ../submodules/amrex
include ../Make.Emu
